SUPABASE_URL=https://ziwvhmcrcmxqajyqhcfp.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inppd3ZobWNyY214cWFqeXFoY2ZwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIzMzY4NjAsImV4cCI6MjA5NzkxMjg2MH0.2t7LONc7tkNhDtl8YDt0v353nFwrEx3ACtPBsAWZy6o
APP_URL=https://quiz.autoshiftops.com

# Service role key — full DB bypass, RLS does not apply. Server-side only
# (lib/supabaseAdmin.ts), used for the waitlist insert since there's no
# signed-in user to satisfy a normal RLS policy against. Never expose this
# to the client, never prefix it NEXT_PUBLIC_. Real value lives in Vercel
# env vars only — see the M2-02 commit notes for where to get it.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key...

# AI Provider — switch between openai and anthropic
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...

# When you get your first paid customer, switch to:
# AI_PROVIDER=anthropic
# AI_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-...

# Google Analytics 4 — optional. When unset, GA4 script and tracking calls
# are skipped entirely (no errors, no network calls).
# Measurement IDs are not secrets — they're embedded in every page's public
# HTML by design — so the real value is committed here directly.
# Property 549179290 (G-JRMPGDV2DM) is the correct/active one.
NEXT_PUBLIC_GA_ID=G-JRMPGDV2DM

# Sentry error monitoring — optional. Sentry.init() only actually enables
# itself when NODE_ENV=production (see instrumentation.ts /
# instrumentation-client.ts), so this is inert locally either way. Unlike
# the GA ID above, this is left as a placeholder rather than the real DSN —
# add the real value to Vercel env vars directly.
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Client-side Sentry DSN — deliberately a *different* env var from
# SENTRY_DSN above, not just a duplicate: server-only env vars never reach
# browser code in Next.js, so instrumentation-client.ts needs its own
# NEXT_PUBLIC_-prefixed one. DSNs aren't secrets (they're meant to ship in
# public browser bundles), but this still stays a placeholder here — same
# reasoning as SENTRY_DSN, real value goes to Vercel directly.
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# Pro waitlist (M2-02) — Resend for admin notification + signup auto-reply.
# Left as a placeholder here on purpose (same reasoning as SENTRY_DSN
# above) — the real key was shared in chat for this task and goes straight
# into Vercel env vars, never into a committed file or a commit message.
RESEND_API_KEY=re_xxxx
ADMIN_EMAIL=admin@autoshiftops.com
NEXT_PUBLIC_APP_URL=https://quiz.autoshiftops.com